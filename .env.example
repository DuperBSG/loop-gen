# Use one provider. Native Anthropic support:
ANTHROPIC_API_KEY=
# Optional: openai, anthropic. If omitted, Anthropic is selected when only
# ANTHROPIC_API_KEY is set; otherwise OpenAI-compatible mode is used.
AGENT_LOOP_PROVIDER=

OPENAI_API_KEY=
# Optional. Use for OpenRouter, Azure, local servers, etc.
# OPENAI_BASE_URL=https://api.openai.com/v1
# Optional. Defaults to gpt-4o-mini (OpenAI) or
# claude-sonnet-4-5 (Anthropic).
# AGENT_LOOP_MODEL=
